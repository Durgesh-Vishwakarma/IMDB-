# TMDB API key — https://www.themoviedb.org/settings/api
API_KEY=your_tmdb_api_key

# Public site URL. Leave unset on Vercel: the code falls back to
# VERCEL_PROJECT_PRODUCTION_URL automatically. Set this once you attach a
# custom domain, so canonical tags, sitemap.xml, robots.txt and Open Graph
# images all point at the real host instead of the *.vercel.app one.
# NEXT_PUBLIC_SITE_URL=https://moviehub.example.com
